node_modules/
src/web/public/
*.log
.DS_Store
.env
.env.local
.nx-rp-workflows/
*.tgz

# Rust crate build artifacts
rust/rsx-sc-rust/target/
rust/**/target/

# GH Actions dist/ output
dist/

# 二进制不入库（每个 ~4.7 MB，进了历史就永久留在 clone 里）。
# 发布时由 npm-publish.yml 从 CI 构建产物下载到 binaries/ 再打包；
# 本地开发由 src/core/rust-binary.js 回退到 rust/rsx-sc-rust/target/release/。
# .gitkeep 保留目录骨架，好让 package.json 的 files 白名单有个真实落点。
binaries/*
!binaries/.gitkeep

# ============================================================
# Cloned repositories (nested git repos) — sl-git-standard
# 父目录必须用 /* 半透明模式，否则否定规则失效
# ============================================================
.claude/repo/*
!.claude/repo/_read/
!.claude/repo/_read/**

!.claude/repo/_self/
!.claude/repo/_self/**

# git.remote 清单：团队共享状态，入库（别人 clone 本仓库后 sync 即可重建 .claude/repo）
!.claude/www/

# Tool artifacts / scratch tools (本地工具产物，不入库)
.tool/

# Playwright MCP 调试产物（浏览器自动化临时日志/快照）
.playwright-mcp/
